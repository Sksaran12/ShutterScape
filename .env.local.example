# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and is the only file Next.js loads.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Atlas -> Cluster -> Connect -> Drivers -> Node.js.
# Keep the database name (/shutterscape) and the retry options.
# If the password contains @ : / ? # [ ] % it must be percent-encoded; the
# script `node scripts/set-db-password.mjs` does that for you.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shutterscape?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate a strong secret (32+ characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT random value for production; never commit the real one.
NEXTAUTH_SECRET=replace_with_a_random_64_character_hex_string

# Optional: used by the local verification scripts for the sign-in smoke test.
# The admin account itself lives in MongoDB, not in this file.
# ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Cloudinary (server-side signed uploads only)
# ---------------------------------------------------------------------------
# Console -> Dashboard -> "Product Environment Credentials".
# Cloud name is lowercase and is NOT the upload-preset name.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------------------------------------------------------------------------
# Upload size limit (optional)
# ---------------------------------------------------------------------------
# Maximum image size in MB. Defaults to 15 when unset.
# Vercel caps serverless request bodies at 4.5 MB, so set 4 there.
# Render/self-hosting can keep 15.
NEXT_PUBLIC_MAX_UPLOAD_MB=15
